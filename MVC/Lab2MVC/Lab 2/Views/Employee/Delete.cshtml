@model Employee

@{
    ViewData["Title"] = "Delete Employee";
}

<h2>Delete Employee</h2>

<div class="alert alert-danger">
    Are you sure you want to delete this employee?
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-4">Id</dt>
            <dd class="col-sm-8">@Model.Id</dd>

            <dt class="col-sm-4">Name</dt>
            <dd class="col-sm-8">@Model.Name</dd>

            <dt class="col-sm-4">Age</dt>
            <dd class="col-sm-8">@Model.Age</dd>

            <dt class="col-sm-4">Salary</dt>
            <dd class="col-sm-8">@Model.Salary</dd>

            <dt class="col-sm-4">Job Title</dt>
            <dd class="col-sm-8">@Model.JobTitle</dd>

            <dt class="col-sm-4">Department Name</dt>
            <dd class="col-sm-8">@Model.Department?.DepartmentName</dd>
        </dl>
    </div>
</div>

<form asp-controller="Employee" asp-action="Delete" method="post" class="mt-3">
    <input type="hidden" asp-for="Id" />
    <div class="d-flex justify-content-between align-items-center mb-3">
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-controller="Employee" asp-action="Index" class="btn btn-secondary">Back to Employees</a>
    </div>
</form>