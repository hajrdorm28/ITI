@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<h2>Dashboard</h2>

<div class="row g-4 mt-2">
    <div class="col-md-4">
        <div class="card text-bg-primary">
            <div class="card-body">
                <h6 class="card-title">Total Employees</h6>
                <p class="display-6 mb-0">@Model.TotalEmployees</p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card text-bg-secondary">
            <div class="card-body">
                <h6 class="card-title">Total Departments</h6>
                <p class="display-6 mb-0">@Model.TotalDepartments</p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card text-bg-success">
            <div class="card-body">
                <h6 class="card-title">Average Salary</h6>
                <p class="display-6 mb-0">@Model.AverageSalary.ToString("N2")</p>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card text-bg-info">
            <div class="card-body">
                <h6 class="card-title">Highest Salary</h6>
                <p class="display-6 mb-0">@Model.HighestSalary.ToString("N2")</p>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card text-bg-warning">
            <div class="card-body">
                <h6 class="card-title">Lowest Salary</h6>
                <p class="display-6 mb-0">@Model.LowestSalary.ToString("N2")</p>
            </div>
        </div>
    </div>
</div>
