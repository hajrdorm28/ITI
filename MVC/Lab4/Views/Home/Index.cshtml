@{
    ViewData["Title"] = "Home";
}

<h2>Welcome, @ViewBag.WelcomeName!</h2>

<div class="alert alert-primary">
    You visited this page <strong>@ViewBag.VisitCount</strong> time(s).
</div>

<div class="row g-4 mt-2">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Remember my name</h5>
                <p class="card-text">Save your name in a cookie so this page can greet you by name.</p>
                <a asp-controller="Account" asp-action="RememberName" class="btn btn-outline-primary">Set my name</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Login</h5>
                <p class="card-text">Log in to access the Employees and Departments pages.</p>
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary">Login</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Dashboard</h5>
                <p class="card-text">View employee and department statistics.</p>
                <a asp-controller="Home" asp-action="Dashboard" class="btn btn-outline-primary">Open Dashboard</a>
            </div>
        </div>
    </div>
</div>
