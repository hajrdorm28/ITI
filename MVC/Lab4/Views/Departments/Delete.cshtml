@model DepartmentIndexViewModel
@{
    ViewData["Title"] = "Delete Department";
}

<h2>Delete Department</h2>

<div class="alert alert-warning">
    Are you sure you want to delete this department?
    @if (Model.EmployeeCount > 0)
    {
        <div>
            <strong>Warning:</strong> this department has @Model.EmployeeCount employee(s). Deleting it will also delete those employees.
        </div>
    }
</div>

<dl class="row">
    <dt class="col-sm-3">Department Name</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3">Manager Name</dt>
    <dd class="col-sm-9">@Model.ManagerName</dd>

    <dt class="col-sm-3"># Employees</dt>
    <dd class="col-sm-9">@Model.EmployeeCount</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
