@model List<EmployeeIndexViewModel>
@{
    ViewData["Title"] = "Department Employees";
}

<h2>Employees in @ViewBag.DepartmentName</h2>
<p class="text-muted small">This visit was recorded — see "Recently visited" on the Departments page.</p>

<p>
    <a asp-controller="Departments" asp-action="Index" class="btn btn-secondary">Back to Departments</a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Age</th>
            <th>Salary</th>
            <th>Job Title</th>
        </tr>
    </thead>
    <tbody>
    @if (Model.Count == 0)
    {
        <tr>
            <td colspan="5" class="text-center">No employees in this department.</td>
        </tr>
    }
    else
    {
        @foreach (var e in Model)
        {
            <tr>
                <td>@e.Id</td>
                <td>@e.Name</td>
                <td>@e.Age</td>
                <td>@e.Salary.ToString("N2")</td>
                <td>@e.JobTitle</td>
            </tr>
        }
    }
    </tbody>
</table>
