@{
    ViewData["Title"] = "Error";
}

<div class="text-center" style="margin-top: 60px;">
    <h1 class="display-4 text-danger">Oops! Something went wrong.</h1>
    <p class="lead">We're sorry — an unexpected error occurred while processing your request.</p>

    @if (ViewBag.OriginalPath != null)
    {
        <p class="text-muted">Page: <code>@ViewBag.OriginalPath</code></p>
    }

    @if (ViewBag.RequestId != null)
    {
        <p class="text-muted">Request ID: <code>@ViewBag.RequestId</code></p>
    }

    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">Back to Home</a>
</div>
