@{
    var theme = Context.Request.Cookies["Theme"] ?? "Light";
    var isDark = theme == "Dark";
    var username = Context.Session.GetString("Username");
    var currentPath = Context.Request.Path + Context.Request.QueryString;
    var requestNumber = Context.Items["RequestNumber"];
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="@(isDark ? "dark" : "light")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Employee Management System</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="@(isDark ? "bg-dark text-white" : "")">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark mb-3">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">Employee Management System</a>
                <div class="navbar-collapse collapse">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Departments" asp-action="Index">Departments</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Employees" asp-action="Index">Employees</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Home" asp-action="Dashboard">Dashboard</a>
                        </li>
                    </ul>

                    <ul class="navbar-nav align-items-center">
                        <li class="nav-item me-3">
                            <form asp-controller="Account" asp-action="SetTheme" method="post" class="d-flex align-items-center">
                                <input type="hidden" name="returnUrl" value="@currentPath" />
                                <select name="theme" class="form-select form-select-sm" onchange="this.form.submit()" style="width:auto;">
                                    <option value="Light" selected="@(!isDark)">☀️ Light</option>
                                    <option value="Dark" selected="@isDark">🌙 Dark</option>
                                </select>
                            </form>
                        </li>
                        <li class="nav-item">
                            @if (!string.IsNullOrEmpty(username))
                            {
                                <span class="text-white me-2">Hi, @username</span>
                                <a class="btn btn-sm btn-outline-light" asp-controller="Account" asp-action="Logout">Logout</a>
                            }
                            else
                            {
                                <a class="btn btn-sm btn-outline-light" asp-controller="Account" asp-action="Login">Login</a>
                            }
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @if (TempData["Message"] != null)
            {
                <div class="alert alert-success">@TempData["Message"]</div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="container text-muted small border-top pt-2 pb-4">
        @if (requestNumber != null)
        {
            <span>Request #@requestNumber served since startup.</span>
        }
    </footer>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
